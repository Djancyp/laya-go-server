diff --git i/src/models/deberta-v2.cpp w/src/models/deberta-v2.cpp
new file mode 100644
index 0000000..b8ff8e1
--- /dev/null
+++ w/src/models/deberta-v2.cpp
@@ -0,0 +1,169 @@
+// DeBERTa-v2/v3 encoder: disentangled attention (content-to-position + position-to-content)
+// over one relative-position embedding shared by all layers (share_att_key: the position
+// stream reuses each layer's q/k projections).
+//
+//   score[h,i,j] = ( q_i.k_j  +  q_i.posk[idx(i,j)]  +  k_j.posq[idx(i,j)] ) / sqrt(3*d_head)
+//   idx(i,j)     = clamp(log_bucket(pos_i - pos_j) + span, 0, 2*span-1)
+//
+// Post-LN blocks, no RoPE, no absolute positions (position_biased_input=false), no final norm
+// (encoder.LayerNorm only normalises the relative embedding).
+
+#include "models.h"
+
+void llama_model_deberta_v2::load_arch_hparams(llama_model_loader & ml) {
+    ml.get_key(LLM_KV_ATTENTION_LAYERNORM_EPS,          hparams.f_norm_eps);
+    ml.get_key(LLM_KV_ATTENTION_RELATIVE_BUCKETS_COUNT, hparams.n_rel_attn_bkts); // position_buckets
+    ml.get_key(LLM_KV_ATTENTION_RELATIVE_POS_MAX,       hparams.n_rel_pos_max);   // max_relative_positions
+
+    if (hparams.n_rel_attn_bkts == 0 || hparams.n_rel_pos_max == 0) {
+        throw std::runtime_error("deberta-v2: relative_buckets_count and relative_pos_max must be set");
+    }
+
+    switch (hparams.n_layer()) {
+        case 12: type = LLM_TYPE_137M; break;
+        case 24: type = LLM_TYPE_410M; break; // deberta-v3-large
+        default: type = LLM_TYPE_UNKNOWN;
+    }
+}
+
+void llama_model_deberta_v2::load_arch_tensors(llama_model_loader &) {
+    LLAMA_LOAD_LOCALS;
+
+    tok_embd   = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), {n_embd, n_vocab}, 0);
+    tok_norm   = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD_NORM, "weight", 0), {n_embd}, 0);
+    tok_norm_b = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD_NORM, "bias",   0), {n_embd}, 0);
+
+    rel_embd        = create_tensor(tn(LLM_TENSOR_REL_EMBD, "weight"), {n_embd, 2*(int64_t) hparams.n_rel_attn_bkts}, 0);
+    rel_embd_norm   = create_tensor(tn(LLM_TENSOR_REL_EMBD_NORM, "weight"), {n_embd}, 0);
+    rel_embd_norm_b = create_tensor(tn(LLM_TENSOR_REL_EMBD_NORM, "bias"),   {n_embd}, 0);
+
+    for (int i = 0; i < n_layer; ++i) {
+        auto & layer = layers[i];
+
+        create_tensor_qkv(layer, i, n_embd, n_embd, n_embd_gqa, n_embd_gqa, 0);
+
+        layer.wo   = create_tensor(tn(LLM_TENSOR_ATTN_OUT, "weight", i), {n_embd, n_embd}, 0);
+        layer.wo_b = create_tensor(tn(LLM_TENSOR_ATTN_OUT, "bias",   i), {n_embd}, 0);
+
+        layer.attn_out_norm   = create_tensor(tn(LLM_TENSOR_ATTN_OUT_NORM, "weight", i), {n_embd}, 0);
+        layer.attn_out_norm_b = create_tensor(tn(LLM_TENSOR_ATTN_OUT_NORM, "bias",   i), {n_embd}, 0);
+
+        layer.ffn_up     = create_tensor(tn(LLM_TENSOR_FFN_UP,   "weight", i), {n_embd, n_ff}, 0);
+        layer.ffn_up_b   = create_tensor(tn(LLM_TENSOR_FFN_UP,   "bias",   i), {n_ff}, 0);
+        layer.ffn_down   = create_tensor(tn(LLM_TENSOR_FFN_DOWN, "weight", i), {n_ff, n_embd}, 0);
+        layer.ffn_down_b = create_tensor(tn(LLM_TENSOR_FFN_DOWN, "bias",   i), {n_embd}, 0);
+
+        layer.layer_out_norm   = create_tensor(tn(LLM_TENSOR_LAYER_OUT_NORM, "weight", i), {n_embd}, 0);
+        layer.layer_out_norm_b = create_tensor(tn(LLM_TENSOR_LAYER_OUT_NORM, "bias",   i), {n_embd}, 0);
+    }
+}
+
+std::unique_ptr<llm_graph_context> llama_model_deberta_v2::build_arch_graph(const llm_graph_params & params) const {
+    return std::make_unique<graph>(*this, params);
+}
+
+// pos [d_head, n_rows, n_head] . x [d_head, n_tok, n_head]  ->  [n_head, n_rows, n_tok]
+// (head innermost so that get_rows can gather whole per-head vectors by relative bucket)
+static ggml_tensor * deberta_pos_scores(ggml_context * ctx, ggml_tensor * pos_h, ggml_tensor * x_h) {
+    ggml_tensor * s = ggml_mul_mat(ctx, pos_h, x_h);                        // [rows, n_tok, n_head]
+    return ggml_cont(ctx, ggml_permute(ctx, s, 1, 2, 0, 3));                // [n_head, rows, n_tok]
+}
+
+llama_model_deberta_v2::graph::graph(const llama_model & model, const llm_graph_params & params)
+        : llm_graph_context(params) {
+    const int64_t n_embd_head = hparams.n_embd_head_v();
+    const int64_t n_rows      = 2*(int64_t) hparams.n_rel_attn_bkts;
+
+    GGML_ASSERT(n_embd_head == hparams.n_embd_head_k());
+    GGML_ASSERT(model.rel_embd);
+
+    auto inp_rel = std::make_unique<llm_graph_input_pos_bucket_deberta>(hparams);
+    inp_rel->idx_c2p = ggml_new_tensor_2d(ctx0, GGML_TYPE_I32, n_tokens, n_tokens);
+    inp_rel->idx_p2c = ggml_new_tensor_2d(ctx0, GGML_TYPE_I32, n_tokens, n_tokens);
+    ggml_set_input(inp_rel->idx_c2p);
+    ggml_set_input(inp_rel->idx_p2c);
+    ggml_tensor * idx_c2p = inp_rel->idx_c2p;
+    ggml_tensor * idx_p2c = inp_rel->idx_p2c;
+    res->add_input(std::move(inp_rel));
+
+    ggml_tensor * inpL = build_inp_embd(model.tok_embd);
+    inpL = build_norm(inpL, model.tok_norm, model.tok_norm_b, LLM_NORM, 0);
+    cb(inpL, "inp_norm", 0);
+
+    // norm_rel_ebd == layer_norm; the CUDA/CPU norm wants F32
+    ggml_tensor * rel_src = model.rel_embd;
+    if (rel_src->type != GGML_TYPE_F32) {
+        rel_src = ggml_cast(ctx0, rel_src, GGML_TYPE_F32);
+    }
+    ggml_tensor * rel_e = build_norm(rel_src, model.rel_embd_norm, model.rel_embd_norm_b, LLM_NORM, -1);
+    cb(rel_e, "rel_e", -1);
+
+    auto * inp_attn = build_attn_inp_no_cache();
+
+    // all three score terms share sqrt(d_head * (1 + #pos_att_types)) with pos_att_type = [p2c, c2p]
+    const float kq_scale = 1.0f / sqrtf(3.0f * (float) n_embd_head);
+
+    for (int il = 0; il < n_layer; ++il) {
+        const auto & L = model.layers[il];
+
+        auto [Qcur, Kcur, Vcur] = build_qkv(L, inpL, n_embd_head, n_head, n_head_kv, il);
+
+        // share_att_key: position stream goes through the layer's own q/k projections
+        ggml_tensor * pos_q = ggml_mul_mat(ctx0, L.wq, rel_e);
+        ggml_tensor * pos_k = ggml_mul_mat(ctx0, L.wk, rel_e);
+        if (L.wq_b) { pos_q = ggml_add(ctx0, pos_q, L.wq_b); }
+        if (L.wk_b) { pos_k = ggml_add(ctx0, pos_k, L.wk_b); }
+
+        // [n_embd, rows] -> [d_head, rows, n_head]
+        pos_q = ggml_cont(ctx0, ggml_permute(ctx0, ggml_reshape_3d(ctx0, pos_q, n_embd_head, n_head, n_rows), 0, 2, 1, 3));
+        pos_k = ggml_cont(ctx0, ggml_permute(ctx0, ggml_reshape_3d(ctx0, pos_k, n_embd_head, n_head, n_rows), 0, 2, 1, 3));
+
+        // [d_head, n_head, n_tok] -> [d_head, n_tok, n_head]
+        ggml_tensor * q_h = ggml_cont(ctx0, ggml_permute(ctx0, Qcur, 0, 2, 1, 3));
+        ggml_tensor * k_h = ggml_cont(ctx0, ggml_permute(ctx0, Kcur, 0, 2, 1, 3));
+
+        // kq layout in build_attn_mha is [n_kv(key j), n_tokens(query i), n_head].
+        //
+        // c2p[j,i,h] = q_i . posk[idx(i,j)]
+        ggml_tensor * c2p = deberta_pos_scores(ctx0, pos_k, q_h);                     // [n_head, rows, i]
+        c2p = ggml_get_rows(ctx0, c2p, idx_c2p);                                      // [n_head, j, i]
+        c2p = ggml_cont(ctx0, ggml_permute(ctx0, c2p, 2, 0, 1, 3));                   // [j, i, n_head]
+        cb(c2p, "rel_c2p", il);
+
+        // p2c[j,i,h] = k_j . posq[idx(i,j)]
+        ggml_tensor * p2c = deberta_pos_scores(ctx0, pos_q, k_h);                     // [n_head, rows, j]
+        p2c = ggml_get_rows(ctx0, p2c, idx_p2c);                                      // [n_head, i, j]
+        p2c = ggml_cont(ctx0, ggml_permute(ctx0, p2c, 2, 1, 0, 3));                   // [j, i, n_head]
+        cb(p2c, "rel_p2c", il);
+
+        ggml_tensor * kq_b = ggml_add(ctx0, c2p, p2c); // raw; build_attn applies kq_scale to (qk + kq_b)
+
+        ggml_tensor * cur = build_attn(inp_attn, L.wo, L.wo_b, L.wo_s,
+                Qcur, Kcur, Vcur, kq_b, nullptr, nullptr, kq_scale, il);
+        cb(cur, "kqv_out", il);
+
+        // post-LN
+        cur = ggml_add(ctx0, cur, inpL);
+        cur = build_norm(cur, L.attn_out_norm, L.attn_out_norm_b, LLM_NORM, il);
+        cb(cur, "attn_out_norm", il);
+
+        ggml_tensor * ffn_inp = cur;
+
+        // exact (erf) GELU, as in transformers hidden_act="gelu"
+        cur = ggml_add(ctx0, ggml_mul_mat(ctx0, L.ffn_up, cur), L.ffn_up_b);
+        cur = ggml_gelu_erf(ctx0, cur);
+        cur = ggml_add(ctx0, ggml_mul_mat(ctx0, L.ffn_down, cur), L.ffn_down_b);
+        cb(cur, "ffn_out", il);
+
+        cur = ggml_add(ctx0, cur, ffn_inp);
+        cur = build_norm(cur, L.layer_out_norm, L.layer_out_norm_b, LLM_NORM, il);
+        cb(cur, "ffn_out_norm", il);
+
+        inpL = cur;
+    }
+
+    // no final norm: DebertaV2Encoder returns the last layer output as is
+    cb(inpL, "result_embd", -1);
+    res->t_embd = inpL;
+    ggml_build_forward_expand(gf, inpL);
+}
