+// transformers make_log_bucket_position (deberta-v2), single signed distance
+static int32_t llama_deberta_log_bucket(int32_t rel, int32_t bucket_size, int32_t max_position) {
+    const int32_t mid = bucket_size / 2;
+    const int32_t a   = std::abs(rel);
+    const int32_t abs_pos = a < mid ? mid - 1 : a;
+    if (abs_pos <= mid) {
+        return rel;
+    }
+    // transformers computes this in float32
+    const float lp = std::ceil(std::log((float) abs_pos / (float) mid) /
+                               std::log((float) (max_position - 1) / (float) mid) * (float) (mid - 1));
+    const int32_t log_pos = (int32_t) lp + mid;
+    return rel < 0 ? -log_pos : log_pos;
+}
+
+void llm_graph_input_pos_bucket_deberta::set_input(const llama_ubatch * ubatch) {
+    if (!idx_c2p) {
+        return;
+    }
+    GGML_ASSERT(ggml_backend_buffer_is_host(idx_c2p->buffer));
+    GGML_ASSERT(ggml_backend_buffer_is_host(idx_p2c->buffer));
+
+    const int64_t n    = ubatch->n_tokens;
+    const int32_t span = (int32_t) hparams.n_rel_attn_bkts;
+    const int32_t top  = 2*span - 1;
+
+    int32_t * c2p = (int32_t *) idx_c2p->data;
+    int32_t * p2c = (int32_t *) idx_p2c->data;
+
+    for (int64_t i = 0; i < n; ++i) {         // query
+        for (int64_t j = 0; j < n; ++j) {     // key
+            int32_t b = llama_deberta_log_bucket(ubatch->pos[i] - ubatch->pos[j], span, (int32_t) hparams.n_rel_pos_max) + span;
+            b = b < 0 ? 0 : (b > top ? top : b);
+            c2p[i*n + j] = b; // ne0 = j
+            p2c[j*n + i] = b; // ne0 = i
+        }
+    }
+}
