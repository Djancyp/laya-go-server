+@ModelBase.register("DebertaV2Model", "DebertaV2ForMaskedLM")
+class DebertaV2Model(TextModel):
+    """DeBERTa-v2/v3 encoder (also the encoder inside GLiNER2 checkpoints)."""
+    model_arch = gguf.MODEL_ARCH.DEBERTA_V2
+
+    def __init__(self, dir_model: Path, *args, **kwargs):
+        hparams = kwargs.pop("hparams", None)
+        if hparams is None:
+            hparams = ModelBase.load_hparams(dir_model, False)
+        # GLiNER checkpoints keep the encoder config in encoder_config/config.json
+        enc = dir_model / "encoder_config" / "config.json"
+        if enc.is_file():
+            with open(enc, "r", encoding="utf-8") as f:
+                hparams = {**hparams, **json.load(f)}
+        super().__init__(dir_model, *args, hparams=hparams, **kwargs)
+
+    def set_gguf_parameters(self):
+        super().set_gguf_parameters()
+        self.gguf_writer.add_causal_attention(False)
+        self.gguf_writer.add_layer_norm_eps(self.hparams.get("layer_norm_eps", 1e-7))
+
+        buckets = self.hparams.get("position_buckets") or 0
+        if buckets <= 0:
+            raise ValueError("deberta: position_buckets required")
+        self.gguf_writer.add_relative_attn_buckets_count(buckets)
+
+        max_pos = self.hparams.get("max_relative_positions")
+        if not isinstance(max_pos, int) or max_pos < 1:
+            max_pos = self.hparams["max_position_embeddings"]
+        self.gguf_writer.add_relative_attn_pos_max(max_pos)
+
+        assert self.hparams.get("share_att_key") and self.hparams.get("relative_attention")
+        assert set(self.hparams.get("pos_att_type", [])) == {"p2c", "c2p"}
+        assert not self.hparams.get("position_biased_input", True)
+        assert self.hparams.get("norm_rel_ebd") == "layer_norm"
+
+    def get_vocab_base_pre(self, tokenizer) -> str:
+        # Metaspace/Unigram, not byte-level BPE: the BPE pre-tokenizer hash table does not apply
+        return "default"
+
+    def set_vocab(self):
+        # DeBERTa-v3: Metaspace + Unigram tokenizer.json -> SPM-style vocab with scores
+        with open(self.dir_model / "tokenizer.json", "r", encoding="utf-8") as f:
+            tokjson = json.load(f)
+        if tokjson.get("model", {}).get("type") != "Unigram":
+            raise ValueError("deberta: expected Unigram tokenizer.json")
+        scores_by_piece = {p: float(sc) for p, sc in tokjson["model"]["vocab"]}
+
+        tokens, toktypes, tokpre = self.get_vocab_base()
+        scores = [scores_by_piece.get(t, 0.0) for t in tokens]
+
+        self.gguf_writer.add_tokenizer_model("llama")
+        self.gguf_writer.add_tokenizer_pre("default")
+        self.gguf_writer.add_token_list(tokens)
+        self.gguf_writer.add_token_types(toktypes)
+        self.gguf_writer.add_token_scores(scores)
+        self.gguf_writer.add_token_type_count(self.hparams.get("type_vocab_size", 0) or 0)
+
+        special_vocab = gguf.SpecialVocab(self.dir_model, n_vocab=len(tokens))
+        special_vocab.add_to_gguf(self.gguf_writer)
+
+    @classmethod
+    def filter_tensors(cls, item: tuple[str, Callable[[], Tensor]]) -> tuple[str, Callable[[], Tensor]] | None:
+        name, gen = item
+
+        if name.startswith("deberta."):
+            name = name[8:]
+        # GLiNER wrapper: encoder.<hf encoder module names>
+        if name.startswith(("encoder.encoder.", "encoder.embeddings.")):
+            name = name[len("encoder."):]
+
+        if name.endswith(".gamma"):
+            name = name[:-6] + ".weight"
+        if name.endswith(".beta"):
+            name = name[:-5] + ".bias"
+
+        # no absolute positions / token types in v3; drop heads that are not the encoder
+        if name.startswith(("embeddings.position", "embeddings.token_type", "pooler.", "cls.", "lm_predictions.", "mask_predictions.")):
+            return None
+        # GLiNER2 task heads live in the same safetensors
+        if name.startswith(("classifier.", "count_embed.", "count_pred.", "span_rep.")):
+            return None
+
+        return super().filter_tensors((name, gen))
+
